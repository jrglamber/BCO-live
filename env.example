# ---------------- REQUIRED / SET IN RAILWAY ----------------
WEBHOOK_SECRET=REPLACE_ME
ADMIN_SECRET=REPLACE_ME
DATABASE_URL=${{Postgres.DATABASE_URL}}

# OANDA — use practice first. Never commit real credentials.
OANDA_ENABLED=true
OANDA_ENV=practice
OANDA_ACCOUNT_ID=REPLACE_ME
OANDA_API_TOKEN=REPLACE_ME
# Leave blank until /broker/instruments/discover confirms the exact Brent symbol.
BCO_OANDA_INSTRUMENT=

# ---------------- INITIAL LOCKED STATE ----------------
BROKER_READ_ONLY=true
BROKER_EXECUTION_ENABLED=false
BROKER_KILL_SWITCH=true
BCO_LIVE_EXECUTION_ARMED=false
BCO_AUTO_ENTRY_ENABLED=false
BCO_AUTO_MANAGEMENT_ENABLED=false
BCO_PRACTICE_SMOKE_TEST_ENABLED=false

# ---------------- BCO LIVE V1 ----------------
BCO_DIRECTION=long
BCO_RISK_PER_TRADE_GBP=5
BCO_SL_PCT=3.5
BCO_MIN_HOLD_HOURS=48
BCO_MAX_OPEN_TRADES=250
BCO_FRESH_SIGNAL_MAX_AGE_SECONDS=7200

# Runner protection
BCO_PROTECT_48=0.25
BCO_PROTECT_72=0.50
BCO_PROTECT_96=0.65
BCO_PROTECT_120=0.75
BCO_MIN_STOP_STEP_PCT=0.02

# Basket staging copied from current live index behaviour
MIN_OPEN_FOR_LIGHT_TRIM=10
MIN_OPEN_FOR_NORMAL_TRIM=25
MIN_OPEN_FOR_FULL_CLOSE=50
HEAVY_BASKET_OPEN_TRADES=100
MIN_OPEN_FOR_ENTRY_BLOCK=10
MIN_OPEN_FOR_STRICT_ENTRY_BLOCK=25
ENTRY_BLOCK_TINY_SEVERE_R=-3.0
ENTRY_BLOCK_EARLY_SEVERE_R=-2.0

# Broker guardrails — tune after practice sizing test if evidence supports it.
BROKER_MAX_SPREAD_PCT=0.20
BROKER_MAX_RISK_OVERAGE_PCT=25
BROKER_RECONCILE_INTERVAL_SECONDS=60
